{
  "name": "Excellence Platform Dev Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  "forwardPorts": [8000, 5432],
  "portsAttributes": {
    "8000": { "label": "FastAPI Backend" },
    "5432": { "label": "PostgreSQL + pgvector" }
  },

  "containerEnv": {
    "ANDROID_HOME": "/opt/android-sdk",
    "DATABASE_URL": "postgresql+psycopg2://excellence:excellence@db:5432/excellence_platform",
    "JWT_SECRET_KEY": "dev-only-change-before-production"
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.java",
        "vscjava.vscode-gradle",
        "vscjava.vscode-java-pack"
      ]
    }
  },

  "remoteUser": "vscode"
}
